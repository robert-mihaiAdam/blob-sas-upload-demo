# Azure Storage credentials
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key_base64

# Container where log blobs will be stored
AZURE_STORAGE_CONTAINER_NAME=logs

# SAS token lifetime in minutes (default: 5)
SAS_EXPIRY_MINUTES=5

# Backend server port (default: 3000)
PORT=3000

# Agent: URL of the backend service
BACKEND_URL=http://localhost:3000
